@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const cards = [...document.querySelectorAll('[data-service-card]')];
            const panels = [...document.querySelectorAll('[data-show-panel]')];

            if (typeof IntersectionObserver === 'undefined' ||
                window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                cards.forEach(t => t.classList.add('is-visible'));
            } else {
                const io = new IntersectionObserver((entries) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        entry.target.classList.add('is-visible');
                        io.unobserve(entry.target);
                    });
                }, { threshold: 0.15 });
                cards.forEach(t => io.observe(t));
            }

            function select(card) {
                const target = card.dataset.target;
                cards.forEach((c) => {
                    const on = c === card;
                    c.classList.toggle('active', on);
                    c.setAttribute('aria-expanded', String(on));
                });
                panels.forEach((p) => {
                    p.classList.toggle('active', p.dataset.showPanel === target);
                });
            }

            cards.forEach((card) => {
                card.addEventListener('click', () => select(card));
            });

            const scroller = document.querySelector('.services-grid');
            const btnPrev = document.querySelector('.svc-nav-prev');
            const btnNext = document.querySelector('.svc-nav-next');

            function step() {
                const c = scroller.querySelector('.service-card');
                if (!c) return 0;
                const g = parseInt(getComputedStyle(scroller).columnGap, 10) || 16;
                return c.getBoundingClientRect().width + g;
            }
            btnPrev.addEventListener('click', (e) => {
                e.preventDefault();
                scroller.scrollBy({ left: -step(), behavior: 'smooth' });
            });
            btnNext.addEventListener('click', (e) => {
                e.preventDefault();
                scroller.scrollBy({ left: step(), behavior: 'smooth' });
            });

            select(cards[0]);

            const mediaImages = [...document.querySelectorAll('.service-panel-media img')];
            (function poll() {
                fetch('/Services/ImagesVersion', { cache: 'no-store' })
                    .then((r) => r.json())
                    .then((d) => {
                        if (typeof window.__svcV !== 'undefined' && d.v !== window.__svcV) {
                            window.__svcV = d.v;
                            mediaImages.forEach((img) => {
                                const base = img.getAttribute('src').split('?')[0];
                                img.src = base + '?v=' + d.v;
                            });
                        } else {
                            window.__svcV = d.v;
                        }
                    })
                    .catch(() => {})
                    .finally(() => setTimeout(poll, 2000));
            })();
        });
    </script>
}