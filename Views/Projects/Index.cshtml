                    </ul>
                </div>
                <a asp-controller="Home" asp-action="Contact" class="project-area-link">VER CASO <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
            </article>

            <article class="project-area-card" data-project-card>
                <div class="project-area-top"><span>06</span><i class="fa-solid fa-shield-halved"></i></div>
                <div class="project-area-body">
                    <span class="project-area-tag">SEGURIDAD · 2026</span>
                    <h3>Análisis forense</h3>
                    <p>Investigación de evidencia digital y documentación técnica para procesos internos.</p>
