                    <ul class="project-area-tags">
                        <li>Sistemas</li><li>Panel</li><li>CRUD</li><li>Base de datos</li>
                    </ul>
                </div>
                <a asp-controller="Home" asp-action="Contact" class="project-area-link">VER CASO <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
            </article>

            <article class="project-area-card" data-project-card>
