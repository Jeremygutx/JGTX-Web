    <div class="circuit-page-content">
    <div class="projects-page-grid" aria-hidden="true"></div>
    <div class="projects-page-glow projects-page-glow-one" aria-hidden="true"></div>
    <div class="projects-page-glow projects-page-glow-two" aria-hidden="true"></div>

    <header class="projects-page-hero">
