                        <li>Evidencia</li><li>Informes</li><li>Preservación</li>
                    </ul>
                </div>
                <a asp-controller="Home" asp-action="Contact" class="project-area-link">VER CASO <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
            </article>
        </div>
    </section>

    <section class="projects-stats">
        <div class="projects-stat"><b>100%</b><span>ENFOQUE DIGITAL</span></div>
        <div class="projects-stat"><b>+1</b><span>PROYECTO A LA VEZ</span></div>
        <div class="projects-stat"><b>24/7</b><span>DISPONIBILIDAD</span></div>
