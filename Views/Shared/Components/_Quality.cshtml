<section class="quality-section jgtx-reveal-section" data-reveal="quality">
    <div class="quality-container">
        <div class="quality-ambient" aria-hidden="true"></div>
        <div class="quality-grid-lines" aria-hidden="true"></div>

        <div class="quality-main">
            <div class="quality-eyebrow">
                <span class="quality-dot"></span>
                JGTX TECH / STANDARD
            </div>

            <span class="quality-label">TECNOLOGÍA SIN COMPROMISOS</span>

            <h2>
                CALIDAD QUE
                <span>TE ACOMPAÑA</span>
            </h2>

            <p>
                Seleccionamos tecnología, herramientas y soluciones pensadas para ofrecer
                rendimiento, confianza y una experiencia a la altura de tu próximo proyecto.
            </p>

            <a asp-controller="Home"
               asp-action="About"
               class="quality-button">
                Conoce JGTX
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        <div class="quality-features">
            <article class="quality-feature" data-quality-index="01">
                <div class="quality-feature-top">
                    <span class="quality-index">01</span>
                    <div class="quality-icon"><i class="fa-solid fa-gem"></i></div>
                </div>
                <h3>Calidad Premium</h3>
                <p>Productos y soluciones seleccionados con criterio técnico.</p>
                <span class="quality-line"></span>
            </article>

            <article class="quality-feature" data-quality-index="02">
                <div class="quality-feature-top">
                    <span class="quality-index">02</span>
                    <div class="quality-icon"><i class="fa-solid fa-microchip"></i></div>
                </div>
                <h3>Tecnología Actual</h3>
                <p>Herramientas modernas para proyectos preparados para crecer.</p>
                <span class="quality-line"></span>
            </article>

            <article class="quality-feature" data-quality-index="03">
                <div class="quality-feature-top">
                    <span class="quality-index">03</span>
                    <div class="quality-icon"><i class="fa-solid fa-headset"></i></div>
                </div>
                <h3>Acompañamiento</h3>
                <p>Estamos contigo antes, durante y después de cada solución.</p>
                <span class="quality-line"></span>
            </article>
        </div>

        <div class="quality-metrics" aria-label="Indicadores JGTX">
            <div class="quality-metric">
                <strong data-counter="100">100</strong><span>%</span>
                <small>Enfoque digital</small>
            </div>
            <div class="quality-metric">
                <strong data-counter="24">24</strong><span>/7</span>
                <small>Soporte y atención</small>
            </div>
            <div class="quality-metric">
                <strong data-counter="01">01</strong><span></span>
                <small>Visión: tecnología + IA</small>
            </div>
        </div>
    </div>
</section>
