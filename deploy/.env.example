# ============ JGTX Web — variables de despliegue ============

# Dominio público (sin https://).
# FASE DE PRUEBA (gratis): subdominio DuckDNS, por ejemplo jgtx.duckdns.org
#   - Crea la cuenta en duckdns.org, activa "jgtx" y ponle la IP de tu VM.
#   - Deja el A record apuntando a esa IP (si la VM usa IP pública reservada,
#     no hace falta el cliente DDNS).
# DOMAIN=jgtx.duckdns.org
#
# PRODUCCIÓN (recomendado): compra el dominio y apunta su DNS a la IP.
DOMAIN=TU_DOMINIO_O_SUBDOMINIO

# App
ASPNETCORE_ENVIRONMENT=Production
# Mismo valor que DOMAIN con https:// (para robots.txt y sitemap.xml)
Site__BaseUrl=https://jgtx.duckdns.org

# SMTP (el correo de contacto). Ej.: SMTP de Gmail NO recomendado en prod;
# usa Resend SMTP (gratis 100/día) o Brevo (gratis 300/día).
Smtp__Host=smtp.resend.com
Smtp__Port=587
Smtp__UseSsl=false
Smtp__Username=resend
Smtp__Password=RELLENA_CON_TU_KEY_SMTP
Smtp__From=jgtx.tech@gmail.com
Smtp__FromName=JGTX Tech
Smtp__To=jgtx.tech@gmail.com