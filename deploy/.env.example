# ============ JGTX Web — variables de despliegue ============

# Dominio público (sin https://). Debe apuntar (DNS) a la IP de la VM.
DOMAIN=jgtx.tech

# App
ASPNETCORE_ENVIRONMENT=Production
Site__BaseUrl=https://jgtx.tech

# SMTP (el correo de contacto). Ej.: SMTP de Gmail NO recomendado en prod;
# usa Resend SMTP (gratis 100/día) o Brevo (gratis 300/día).
Smtp__Host=smtp.resend.com
Smtp__Port=587
Smtp__UseSsl=false
Smtp__Username=resend
Smtp__Password=RELLENA_CON_TU_KEY_SMTP
Smtp__From=jgtx.tech@gmail.com
Smtp__FromName=JGTX Tech
Smtp__To=jgtx.tech@gmail.com